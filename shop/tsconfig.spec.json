/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Sin `rootDir` ni `outDir`: la prueba de paridad importa el renderizador del backend
    // (`backend/src/render/event-index-page.ts`) para comparar las dos renderizaciones, y un
    // `rootDir` lo rechazaría. Este proyecto solo se usa con `--noEmit`, así que no hay salida que
    // acotar.
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
