{
  "name": "@mudanzapp/shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "brand:index": "node ../.scripts/generate-brand-index.mjs --frontend shop",
    "dev": "ng serve",
    "start": "ng serve",
    "build": "ng build && npm run brand:index",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore --ignore-path ../.gitignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore --ignore-path ../.gitignore"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@mudanzapp/shared": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
