{
  "name": "mudanzapp",
  "version": "0.1.0",
  "private": true,
  "description": "MudanzApp — monorepo with the shared contract, the backend API and one workspace per frontend",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "wiki",
    "shop"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w backend",
    "start": "node backend/dist/index.js",
    "build:web:frontend": "npm run build -w shared && npm run build -w frontend",
    "build:web:wiki": "npm run build -w shared && npm run build -w wiki",
    "build:web:shop": "npm run build -w shared && npm run build -w shop",
    "dev:shared": "npm run dev -w shared",
    "dev:api": "npm run dev -w backend",
    "dev:web:frontend": "npm run dev -w frontend",
    "dev:web:wiki": "npm run dev -w wiki",
    "dev:web:shop": "npm run dev -w shop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w backend",
    "test:api:db": "npm run test:db -w backend",
    "test:api:db:branch": "npm run test:db:branch -w backend",
    "test:web:frontend": "npm run test -w frontend",
    "test:web:wiki": "npm run test -w wiki",
    "test:web:shop": "npm run test -w shop",
    "test:e2e": "tsx e2e/run-e2e.ts",
    "test:e2e:branch": "tsx e2e/run-e2e.ts --branch",
    "db:ping": "npm run db:ping -w backend",
    "db:ping:test": "npm run db:ping:test -w backend",
    "db:ping:branch": "npm run db:ping:branch -w backend",
    "db:ping:branch:test": "npm run db:ping:branch:test -w backend",
    "db:ping:remote": "npm run db:ping:remote -w backend",
    "db:ping:remote:branch": "npm run db:ping:remote:branch -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:remote": "npm run db:migrate:remote -w backend",
    "db:migrate:remote:branch": "npm run db:migrate:remote:branch -w backend",
    "db:migrate:test": "npm run db:migrate:test -w backend",
    "db:migrate:branch": "npm run db:migrate:branch -w backend",
    "db:migrate:branch:test": "npm run db:migrate:branch:test -w backend",
    "invite": "npm run invite -w backend",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .prettierignore --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .prettierignore --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.0.0"
  }
}
