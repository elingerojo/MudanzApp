{
  // Worker de assets del segundo frontend. Sin `main` y sin `_redirects`:
  // un Worker sirve un único `assets.directory` (plantilla §2).
  "name": "mudanzapp-wiki",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist/wiki/browser",
    "not_found_handling": "single-page-application",
  },
}
