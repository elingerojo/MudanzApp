# Referencia versionada y pública: solo nombres, nunca valores.
#
# Los valores viven en `.env.local`, ignorado por git. Una variable vacía cuenta como ausente.
# Las variables de cada capacidad se añaden con la capacidad, nunca antes.

# Leídas hoy por `backend/src/config.ts`, que es el único módulo que lee `process.env`.
PORT=
NODE_ENV=
DATABASE_URL=
APP_BASE_URL=

# Integración OAUTH (identidad de cuenta) y administración: ciclo 1 (`decisiones` §21 y §22).
# `OAUTH_MODE` acepta `live` o `fake`; pruebas y arnés van en `fake`. En `live` se exigen las tres
# siguientes y el token se verifica contra el JWKS del emisor.
OAUTH_MODE=
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Credencial del administrador único: la leen el API (`/admin/*`) y el script `invite`.
ADMIN_TOKEN=

# Origen público del backend: lo usa el script `invite` en remoto; el API no lo lee.
BACKEND_PUBLIC_URL=

# R2 — almacenamiento de objetos (`R2_MODE`). Capacidad de la foto del artículo (3a) y de su lectura
# pública (3c, decisión §26).
#
# `R2_MODE` acepta `live` o `fake`; pruebas y arnés van en `fake`, y el doble no lee ninguna de las
# variables siguientes. En `live` se exigen **las cinco piezas** y un valor vacío cuenta como ausente.
#
# `R2_ENDPOINT` es el endpoint de la API compatible con S3 del bucket, con el Account ID y **sin** el
# nombre del bucket: el bucket viaja en cada comando. `R2_PUBLIC_BASE_URL` es el origen de la **lectura
# pública** —`https://pub-<hash>.r2.dev`—, **sin** el segmento del bucket, **sin la clave** y sin barra
# final: `r2.dev` sirve `/<object_key>` y el objeto ya vive en el bucket, así que añadir el segmento
# duplica la ruta y deja la imagen en `404`. La aplicación solo compone `base + '/' + object_key`.
# Ningún valor se imprime: se copian del dashboard de Cloudflare.
R2_MODE=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# IA — borrador de la ficha (`AI_MODE`, ciclo 3d, decisión §34).
#
# `AI_MODE` acepta `live` o `fake`; pruebas y arnés van en `fake`. En `live` se exigen el modelo y la
# clave, y el default `live` solo aplica porque la capacidad ya está implementada.
#
# `AI_MODEL` es el **identificador del modelo del proveedor** y se parametriza: el proveedor los retira
# y ningún ID se cablea en el código. `AI_API_KEY` no sale del backend, no se versiona y no se imprime;
# viaja en la cabecera `x-goog-api-key` del adaptador `live`, que es el único que la lee. El host de la
# API **no** es una variable: es un hecho del proveedor y vive en el adaptador.
AI_MODE=
AI_MODEL=
AI_API_KEY=
